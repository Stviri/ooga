{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((if|else|repeat|count|each|try|oops|me\\s+can)\\b.*|[^#\"]*\\b(list|box))\\s*$",
    "decreaseIndentPattern": "^\\s*(else|oops)\\b.*$"
  }
}
